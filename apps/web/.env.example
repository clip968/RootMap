# OpenRouter Chat Completions (기본: https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
# 선택: API 베이스 URL (프록시 등을 쓸 때만 변경)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 선택: 모델 ID. 비워두면 OpenRouter 계정의 기본 모델을 사용한다.
# 예: google/gemini-2.5-flash, anthropic/claude-sonnet-4, openai/gpt-5.2
OPENROUTER_MODEL=
# 선택: OpenRouter response_format json_object (호환 안 되면 false)
# OPENROUTER_JSON_MODE=true
# 선택: OpenRouter 앱 attribution 헤더
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=RootMap

# SQLite 파일 경로 (프로젝트 루트 기준 또는 절대 경로)
DATABASE_URL=file:./data/rootmap.db
