# OpenAI 호환 Chat Completions (기본: https://api.openai.com/v1)
OPENAI_API_KEY=
# 선택: API 베이스 URL (Azure/프록시 등)
# OPENAI_BASE_URL=https://api.openai.com/v1
# 선택: 기본 모델
OPENAI_MODEL=gpt-4o-mini
# OpenAI 전용 response_format json_object (호환 안 되면 false)
# OPENAI_JSON_MODE=true

# SQLite 파일 경로 (프로젝트 루트 기준 또는 절대 경로)
DATABASE_URL=file:./data/rootmap.db
